# Copy to .env and fill in. Never commit .env.

# development | production | test
RADYNTA_ENV=development
# REQUIRED in production (32+ random chars):
#   python -c "import secrets; print(secrets.token_hex(32))"
RADYNTA_SECRET_KEY=

# SQLite file (default: instance/radynta.db)
# DATABASE_PATH=instance/radynta.db

# Canonical site + secondary hosts that 301-redirect to it (path and query preserved)
SITE_URL=https://radynta.com
CANONICAL_HOST=radynta.com
REDIRECT_HOSTS=radynta.in,www.radynta.in,www.radynta.com

# Shown on the website only if set. Use real, monitored details.
CONTACT_EMAIL=
CONTACT_PHONE=

# Optional: email alert when an enquiry arrives. Leave blank to store enquiries only
# (visible at /monitor/enquiries). The site never claims an email was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENQUIRY_NOTIFY_TO=

# Website audit crawler limits
AUDIT_MAX_PAGES=25
AUDIT_REQUEST_DELAY=1.0
AUDIT_TIMEOUT=10
AUDIT_MAX_BYTES=2000000

# AI visibility providers (optional). Without keys, run-visibility exits with a
# clear configuration error and collects nothing.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
OPENAI_API_KEY=
# Pick a model your account can use with the web_search tool
OPENAI_MODEL=
VISIBILITY_REQUEST_DELAY=2.0
